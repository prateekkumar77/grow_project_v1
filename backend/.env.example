# Copy to .env and fill in real values. Every setting the backend reads
# from the environment is documented here - nothing load-bearing is
# hardcoded in the app itself.

# --- server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- database -------------------------------------------------------------
DATABASE_URL=sqlite:///data/grow.db

# --- telemetry / status -------------------------------------------------------------
# How old last_seen can be before /api/status reports the ESP32 as offline.
OFFLINE_THRESHOLD_SECONDS=90
# Manual mode auto-reverts to auto after this many minutes of no
# /api/mode or /api/relay activity.
AUTO_REVERT_MINUTES=30
AUTO_REVERT_CHECK_INTERVAL_SECONDS=60

# --- grow profile (first-run defaults only - see note below) ---------------
# Free-text label for whatever's currently in the tent. Purely descriptive
# - shown in the dashboard header via GET /api/profile. Change it per grow;
# it has no effect on any control logic.
GROW_PROFILE_NAME=Custom grow profile
# Optional. Leave blank to omit the size from the dashboard header.
TENT_SIZE_M2=
# Optional, YYYY-MM-DD. When set, the dashboard header shows a "Day N"
# counter (day 1 = this date). Leave blank to omit it.
GROW_START_DATE=

# --- light schedule (independent of auto/manual mode and decide_relay_state) ---------------
# Starting state for the light: schedule OFF (manual control, off) so a
# fresh deploy never starts cycling a light on an unreviewed default
# photoperiod. Turn the schedule on from the dashboard once on_hours is
# set correctly for what's in the tent.
LIGHT_SCHEDULE_ENABLED_DEFAULT=false
# Hours per day (1-24) the light stays on when the schedule is enabled,
# starting at 00:00 UTC; off_hours is always 24 minus this, computed by
# the backend. Overridable per grow from the dashboard at any time - this
# is only the value a fresh deploy starts with.
LIGHT_DEFAULT_ON_HOURS=18

# --- exhaust schedule (independent of auto/manual mode, decide_relay_state, and any sensor) ---
# Starting state for exhaust: schedule OFF (manual control, off) - same
# "don't actuate on an unreviewed default" rationale as the light
# schedule. Turn the schedule on from the dashboard once run/interval are
# set correctly for what's in the tent.
EXHAUST_SCHEDULE_ENABLED_DEFAULT=false
# Duty cycle: run for this many minutes, repeating every this many
# minutes (both 1-60), anchored to 00:00 UTC. off duration is always
# interval minus run, computed by the backend. Overridable per grow from
# the dashboard at any time - this is only the value a fresh deploy
# starts with.
EXHAUST_DEFAULT_RUN_MINUTES=1
EXHAUST_DEFAULT_INTERVAL_MINUTES=5

# --- decision engine thresholds (the "grow profile" - all absolute values, no rolling baseline) ---
# Exhaust is NOT part of this - it's driven entirely by its own schedule
# above, never by humidity/temperature. Only AC (via Home Assistant) and
# fan escalate here.
#
# NOTE: all grow-profile values (these thresholds, ALERT_TEMP_C below, and
# GROW_PROFILE_NAME/TENT_SIZE_M2 above) are editable live from the
# dashboard's "profile" tab, and a saved edit is stored in the database and
# survives a backend restart - these env vars are read only as the very
# first-run default, before anyone has ever saved a profile from the
# dashboard. Edit them here if you want to change that first-run default;
# edit them from the dashboard to change the profile a running system uses.
HUMIDITY_HIGH_THRESHOLD=65
HUMIDITY_LOW_THRESHOLD=40
# Absolute tent temperature (°C), not a rise relative to any baseline.
# TEMP_FAN_THRESHOLD_C: fan alone. TEMP_AC_THRESHOLD_C: escalate to AC.
# TEMP_LOW_THRESHOLD_C: unusually cold - AC off, fan pulls in warmer room
# air. Placeholder values; tune against your actual tent/strain.
TEMP_FAN_THRESHOLD_C=26.0
TEMP_AC_THRESHOLD_C=28.0
TEMP_LOW_THRESHOLD_C=18.0
SOIL_MOISTURE_LOW_THRESHOLD=35
SOIL_MOISTURE_HYSTERESIS=5

# --- history endpoint -------------------------------------------------------------
HISTORY_DEFAULT_LIMIT=100
HISTORY_MAX_LIMIT=1000

# --- excel export -------------------------------------------------------------
EXPORT_PATH=data/readings_export.xlsx
EXPORT_INTERVAL_MINUTES=60
# On-demand only (POST /api/activity/export) - no scheduled background
# export for this one, unlike EXPORT_PATH above.
ACTIVITY_EXPORT_PATH=data/activity_log_export.xlsx

# --- high-temperature safety response (part of the grow profile - see note above) -------------------
# Temperature at which the backend forces fan and AC on directly,
# overriding auto/manual mode - no Home Assistant notification (no
# media/speaker device connected). Distinct from (and lower than) the
# firmware's own offline-only EMERGENCY_TEMP_C floor in config.h. Not a
# one-way floor like the firmware's: once the reading drops back below
# this, normal mode/decision-engine logic resumes control on the next
# telemetry cycle.
ALERT_TEMP_C=32.0

# --- home assistant integration -------------------------------------------------------------
HA_URL=http://homeassistant:8123
HA_TOKEN=changeme-long-lived-access-token
# How often the backend checks whether Home Assistant is reachable
# (GET /api/), shown as a live connection indicator on the dashboard's
# Home Assistant panel. Runs on its own schedule, not per-request, so a
# slow/hanging HA never adds latency to a page load.
HA_HEALTH_CHECK_INTERVAL_SECONDS=30

# The AC is a Google Home device with no ESP32 relay - the decision
# engine's "ac" state is pushed here via Home Assistant instead. Domain is
# usually "switch" for an AC plugged into a smart plug, or "climate" for a
# native smart AC/mini-split integration.
HA_AC_ENTITY=switch.grow_tent_ac
HA_AC_DOMAIN=switch
HA_REQUEST_TIMEOUT_SECONDS=5

# --- dashboard auth -------------------------------------------------------------
# HTTP Basic Auth - no new dependency, matches the dashboard's own
# no-build-step/no-CDN philosophy. JSON array of {username, password, role}.
# role must be "admin" (full control) or "viewer" (read-only - every POST
# endpoint returns 403; GET/HEAD are unaffected). POST /api/telemetry (the
# ESP32 firmware) is the one exception - it is never protected, since the
# firmware sends no Authorization header at all.
# Passwords are plaintext here, same trust model as every other credential
# already in this file (HA_TOKEN, etc.) - keep .env out of version control
# and treat it like any other secret.
# Leaving this empty/unset means the dashboard rejects every request - there
# is no default admin/admin shipped in code.
DASHBOARD_USERS=[{"username":"admin","password":"changeme-admin","role":"admin"},{"username":"viewer","password":"changeme-viewer","role":"viewer"}]
