# Copy to .env and fill in real values. Every setting the backend reads
# from the environment is documented here - nothing load-bearing is
# hardcoded in the app itself.

# --- server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- database -------------------------------------------------------------
DATABASE_URL=sqlite:///data/grow.db

# --- telemetry / status -------------------------------------------------------------
# How old last_seen can be before /api/status reports the ESP32 as offline.
OFFLINE_THRESHOLD_SECONDS=90
# Manual mode auto-reverts to auto after this many minutes of no
# /api/mode or /api/relay activity.
AUTO_REVERT_MINUTES=30
AUTO_REVERT_CHECK_INTERVAL_SECONDS=60

# --- grow profile (dashboard display only, not used by the decision engine) ---------------
# Free-text label for whatever's currently in the tent. Purely descriptive
# - shown in the dashboard header via GET /api/profile. Change it per grow;
# it has no effect on any control logic.
GROW_PROFILE_NAME=Custom grow profile
# Optional. Leave blank to omit the size from the dashboard header.
TENT_SIZE_M2=

# --- light schedule (independent of auto/manual mode and decide_relay_state) ---------------
# Starting state for the light: schedule OFF (manual control, off) so a
# fresh deploy never starts cycling a light on an unreviewed default
# photoperiod. Turn the schedule on from the dashboard once on_hours is
# set correctly for what's in the tent.
LIGHT_SCHEDULE_ENABLED_DEFAULT=false
# Hours per day (1-24) the light stays on when the schedule is enabled,
# starting at 00:00 UTC; off_hours is always 24 minus this, computed by
# the backend. Overridable per grow from the dashboard at any time - this
# is only the value a fresh deploy starts with.
LIGHT_DEFAULT_ON_HOURS=18

# --- decision engine thresholds -------------------------------------------------------------
HUMIDITY_HIGH_THRESHOLD=65
HUMIDITY_LOW_THRESHOLD=40
TEMP_RISE_FAN_THRESHOLD_C=2.0
TEMP_RISE_AC_THRESHOLD_C=3.0
SOIL_MOISTURE_LOW_THRESHOLD=35
SOIL_MOISTURE_HYSTERESIS=5
# Rolling window used to compute the "recent baseline" temp/humidity that
# rises are measured against.
BASELINE_WINDOW_MINUTES=30

# --- history endpoint -------------------------------------------------------------
HISTORY_DEFAULT_LIMIT=100
HISTORY_MAX_LIMIT=1000

# --- excel export -------------------------------------------------------------
EXPORT_PATH=data/readings_export.xlsx
EXPORT_INTERVAL_MINUTES=60

# --- alerts -------------------------------------------------------------
# Temperature at which the backend pushes a Home Assistant/Google Home
# alert. Distinct from (and lower than) the firmware's own offline-only
# EMERGENCY_TEMP_C floor in config.h.
ALERT_TEMP_C=32.0

# --- home assistant integration -------------------------------------------------------------
HA_URL=http://homeassistant:8123
HA_TOKEN=changeme-long-lived-access-token
HA_SWITCH_ENTITY=switch.grow_tent_exhaust
HA_SPEAKER_ENTITY=media_player.google_home_speaker
HA_ALERT_DEBOUNCE_SECONDS=600
# How often the backend checks whether Home Assistant is reachable
# (GET /api/), shown as a live connection indicator on the dashboard's
# Home Assistant panel. Runs on its own schedule, not per-request, so a
# slow/hanging HA never adds latency to a page load.
HA_HEALTH_CHECK_INTERVAL_SECONDS=30

# The AC is a Google Home device with no ESP32 relay - the decision
# engine's "ac" state is pushed here via Home Assistant instead. Domain is
# usually "switch" for an AC plugged into a smart plug, or "climate" for a
# native smart AC/mini-split integration.
HA_AC_ENTITY=switch.grow_tent_ac
HA_AC_DOMAIN=switch
HA_REQUEST_TIMEOUT_SECONDS=5
