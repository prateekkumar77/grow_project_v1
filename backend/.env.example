# Copy to .env and fill in real values. Every setting the backend reads is
# listed here. Grow-profile values are only first-run defaults: once a
# profile is saved from the dashboard, the database copy is used instead.

# --- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/grow.db

# --- status / mode ----------------------------------------------------------
# ESP32 shown as offline once last_seen is older than this.
OFFLINE_THRESHOLD_SECONDS=90
# Manual mode reverts to auto after this long with no dashboard activity.
AUTO_REVERT_MINUTES=30
AUTO_REVERT_CHECK_INTERVAL_SECONDS=60

# --- grow profile defaults --------------------------------------------------
GROW_PROFILE_NAME=Custom grow profile
# Optional; leave blank to hide.
TENT_SIZE_M2=
# Optional, YYYY-MM-DD; shows a "day N" counter in the header.
GROW_START_DATE=
# Auto mode: AC on at/above high humidity; AC off + fan on at/below low.
HUMIDITY_HIGH_THRESHOLD=65
HUMIDITY_LOW_THRESHOLD=40
# Absolute °C: fan at FAN, AC at AC, AC off + fan on at/below LOW.
TEMP_FAN_THRESHOLD_C=26.0
TEMP_AC_THRESHOLD_C=28.0
TEMP_LOW_THRESHOLD_C=18.0
# Forces fan + AC on in any mode and sends a Telegram alert. Lower than the
# firmware's offline-only EMERGENCY_TEMP_C (config.h).
ALERT_TEMP_C=32.0
# "main": temperature + AC power alerts. "all": also every activity entry.
TELEGRAM_ALERT_MODE=main
# IANA timezone the light, exhaust and pump schedules run in.
SCHEDULE_TIMEZONE=UTC

# --- schedules (set from the dashboard; reset to these on restart) ----------
# Light: on/off times (HH:MM). Off earlier than on wraps past midnight.
LIGHT_SCHEDULE_ENABLED_DEFAULT=false
LIGHT_DEFAULT_ON_TIME=06:00
LIGHT_DEFAULT_OFF_TIME=00:00
# Exhaust: run N minutes every M minutes (1-60). With the schedule off it
# follows the AC in auto mode.
EXHAUST_SCHEDULE_ENABLED_DEFAULT=false
EXHAUST_DEFAULT_RUN_MINUTES=1
EXHAUST_DEFAULT_INTERVAL_MINUTES=5
# Pump: every 1/2/3/4/6/8/12/24 hours for 1-30 seconds.
PUMP_SCHEDULE_ENABLED_DEFAULT=false
PUMP_DEFAULT_INTERVAL_HOURS=12
PUMP_DEFAULT_RUN_SECONDS=3
# Drop a pump run the ESP32 hasn't picked up within this many seconds.
PUMP_RUN_REQUEST_TTL_SECONDS=300

# --- telegram ---------------------------------------------------------------
# See README "Telegram alerts". Blank token or chat id = alerts skipped.
# The token includes the numeric prefix: 123456789:AAH...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum gap between repeat temperature alerts while it stays high.
ALERT_NOTIFY_COOLDOWN_MINUTES=15
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10

# --- home assistant (optional) ----------------------------------------------
HA_URL=http://homeassistant:8123
HA_TOKEN=changeme-long-lived-access-token
HA_HEALTH_CHECK_INTERVAL_SECONDS=30
HA_REQUEST_TIMEOUT_SECONDS=5
# Smart plug sensor entity ids for the live power row; blank = shows "--".
HA_CURRENT_ENTITY=
HA_VOLTAGE_ENTITY=
HA_POWER_ENTITY=
HA_POWER_POLL_INTERVAL_SECONDS=10
# AC power check (needs HA_POWER_ENTITY): this long after an AC command,
# alert if power >= OFF_MAX while off, or < ON_MIN while on.
AC_POWER_CHECK_DELAY_SECONDS=60
AC_OFF_MAX_POWER_W=200
AC_ON_MIN_POWER_W=30

# --- history / exports ------------------------------------------------------
HISTORY_DEFAULT_LIMIT=100
HISTORY_MAX_LIMIT=1000
# Readings export, regenerated every EXPORT_INTERVAL_MINUTES and on demand.
EXPORT_PATH=data/readings_export.xlsx
EXPORT_INTERVAL_MINUTES=60
# Activity log export, on demand only.
ACTIVITY_EXPORT_PATH=data/activity_log_export.xlsx

# --- dashboard auth ---------------------------------------------------------
# HTTP Basic Auth. role "admin" = full control, "viewer" = read-only (403 on
# changes). Plaintext - keep .env out of version control. Empty or invalid =
# every request rejected. /api/telemetry needs no login.
DASHBOARD_USERS=[{"username":"admin","password":"changeme-admin","role":"admin"},{"username":"viewer","password":"changeme-viewer","role":"viewer"}]
